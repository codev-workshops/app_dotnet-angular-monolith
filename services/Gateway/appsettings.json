{
  "Urls": "http://localhost:5100",
  "Cors": {
    "AllowedOrigins": "http://localhost:4200,http://localhost:5100"
  },
  "ReverseProxy": {
    "Routes": {
      "customers": {
        "ClusterId": "customers",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/customers/{**catch-all}" }
      },
      "products": {
        "ClusterId": "products",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "inventory": {
        "ClusterId": "inventory",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/inventory/{**catch-all}" }
      },
      "orders": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      }
    },
    "Clusters": {
      "customers": {
        "Destinations": { "d1": { "Address": "http://localhost:5101" } }
      },
      "products": {
        "Destinations": { "d1": { "Address": "http://localhost:5102" } }
      },
      "inventory": {
        "Destinations": { "d1": { "Address": "http://localhost:5103" } }
      },
      "orders": {
        "Destinations": { "d1": { "Address": "http://localhost:5104" } }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
